{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "t-sql-doradca",
  "account_id": "d509512d3acdca34d35f6677a83a9f0b",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "kv_namespaces": [
    { "binding": "SESSION", "id": "4d8113de422c4532a36fad2bf6aa7700" }
  ],
  "observability": {
    "enabled": true,
  },
}
