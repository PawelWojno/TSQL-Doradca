---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Page not found">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
      <h1 class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-4xl font-bold text-transparent">
        404
      </h1>
      <p class="mb-6 text-blue-100/60">This page doesn't exist.</p>
      <a href="/" class="text-purple-300 hover:underline">
        Back to home
      </a>
    </div>
  </div>
</Layout>
